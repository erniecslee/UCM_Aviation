    "mandatory_wait_time_procedures": {
      "steel_category_c": {
        "mandatory_wait_min": 67,
        "alternate_plate_temp_procedure": {
          "description": "No sooner than 10 and no later than 15 minutes after parking, measure each brake pressure plate surface temperature at a minimum of two points per brake (e.g. Doric Microtemp 450 or equivalent, probe held in place for 20 seconds or until reading stabilizes). If each measured temperature is less than the threshold, immediate dispatch is allowed; otherwise the mandatory_wait_min applies.",
          "plate_temp_threshold_c": 218
        },
        "btms_procedure": {
          "description": "No sooner than 10 and no later than 15 minutes after parking, check the BRAKE TEMP light. If not on, no ground waiting period is required. If on, do not dispatch until at least mandatory_wait_min after landing, or until all BTMS readings on the systems display are below btms_threshold and the BRAKE TEMP light is off.",
          "btms_threshold": 3.5
        },
        "post_wait_check": "Check that wheel thermal plugs have not melted before executing a subsequent takeoff.",
        "btms_caveat": "If any brake temperature display digit is blank or indicates 0.0 or 0.1, the BTMS/plate-temp shortcut method cannot be used and the full mandatory_wait_min applies."
      },
      "carbon_category_n": {
        "mandatory_wait_min": 48,
        "btms_procedure": {
          "description": "No sooner than 10 and no later than 15 minutes after parking, check the BRAKE TEMP light. If not on, no ground waiting period is required. If on, do not dispatch until at least mandatory_wait_min after landing, or until all BTMS readings on the systems display are below btms_threshold and the BRAKE TEMP light is off.",
          "btms_threshold": 3.0
        },
        "post_wait_check": "Check that wheel thermal plugs have not melted before making a subsequent takeoff.",
        "btms_caveat": "If any brake temperature display digit is blank or indicates 0.0 or 0.1, the BTMS shortcut method cannot be used and the full mandatory_wait_min applies.",
        "note": "Carbon brakes (Category N) have no alternate plate-temperature procedure published on this page; only the mandatory wait or BTMS method applies."
      }
    }
  },
